# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
DATABASE_URL=sqlite:////data/access_window.db

# --- Session cookie (parent/admin login) ---
SESSION_SECRET=change-me-32-bytes-random
SESSION_TTL_HOURS=12

# --- Stream tokens (short-lived, MediaMTX-facing) ---
STREAM_TOKEN_SECRET=change-me-different-random-value
STREAM_TOKEN_TTL_SECONDS=90

# --- Invites ---
INVITE_TTL_DAYS=7

# --- Fixed operating timezone (everyone is assumed local to this) ---
APP_TIMEZONE=America/Los_Angeles

# --- MediaMTX ---
# Internal, container-to-container - used by the API to poll camera health.
# Must match the mediamtx container's name so Docker's DNS can resolve it.
MEDIAMTX_API_URL=http://access-window-mediamtx:9997
# Public, browser-facing - whatever NPMPlus fronts MediaMTX's HLS output as.
MEDIAMTX_HLS_BASE_URL=https://cameras.yourdomain.com/hls

# --- Pushover (admin alerts, e.g. camera offline) ---
# One Application token for this whole app. Each admin adds their own
# Pushover *user* key individually via /api/admin/users - not set here.
PUSHOVER_APP_TOKEN=

# --- Bootstrap (used once by `docker compose exec api python -m app.seed`) ---
SEED_SUPER_ADMIN_EMAIL=you@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me
